{
  "name": "byok-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local bridge between AI coding CLIs and OpenAI-compatible providers.",
  "scripts": {
    "test": "node tests/run-all-tests.mjs",
    "test:node": "node --test manager/*.test.mjs tests/*.test.mjs",
    "test:windows-installer": "node --test tests/windows-installer.test.mjs",
    "test:windows-shell": "node --test tests/behavior-matrix.test.mjs",
    "test:linux-installer": "bash tests/linux-installer.test.sh",
    "test:linux-shell": "bash tests/linux-shell-integration.test.sh",
    "test:all:windows": "npm run test:node && npm run test:windows-installer",
    "test:all:linux": "npm run test:node && npm run test:linux-shell && npm run test:linux-installer",
    "bump:patch": "node scripts/bump-version.mjs patch",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major"
  }
}
